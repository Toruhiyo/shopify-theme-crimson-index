{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign say_label = section.settings.say_label
  assign secondary_text = section.settings.secondary_cta_text
  assign cards_title = section.settings.cards_title

  assign listing_url = settings.bizmis_app_listing_url | default: settings.bizmis_app_listing_url_fallback
  assign logo_url = 'bizmis-logo-white-transparent.png' | asset_url

  assign prompts = 'bizmis.panel.examples' | t | newline_to_br | split: '<br />'
  assign tags = 'bizmis.panel.example_tags' | t | newline_to_br | split: '<br />'

  assign cat_menu_handles = 'catalog,main-menu' | split: ','
  assign cat_menu = nil
  for menu_handle in cat_menu_handles
    assign candidate = linklists[menu_handle]
    if candidate.links.size > 0
      assign cat_menu = candidate
      break
    endif
  endfor
-%}

<section class="hero-text hero-voice" {{ section.shopify_attributes }}>
  <div class="page-width hero-voice__inner">
    <div class="hero-voice__main">
      {%- if eyebrow != blank -%}
        <span class="hero-voice__eyebrow">
          <span
            class="hero-voice__eyebrow-mark"
            style="-webkit-mask-image: url('{{ logo_url }}'); mask-image: url('{{ logo_url }}');"
            aria-hidden="true"
          ></span>
          {{ eyebrow }}
        </span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h1 class="hero-voice__heading">{{ heading }}</h1>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="hero-voice__sub">{{ subheading }}</p>
      {%- endif -%}

      {%- comment -%}
        Rotating "say this" demo. Benefit / sub-benefit eyebrow and the shopper
        phrases reuse the shared, localized Bizmis coachmark copy. JS
        (HeroVoiceDemo) cycles the slides and sweeps the karaoke word highlight.
      {%- endcomment -%}
      <div class="hero-voice__demo" data-hero-voice>
        <div class="hero-voice__demo-head" aria-hidden="true">
          <span class="hero-voice__benefit" data-hero-voice-benefit></span>
          <span class="hero-voice__subbenefit" data-hero-voice-sub hidden></span>
        </div>

        <div class="hero-voice__slides" data-hero-voice-slides>
          {%- for prompt in prompts -%}
            {%- assign trimmed = prompt | strip -%}
            {%- if trimmed != blank -%}
              {%- assign tag = tags[forloop.index0] | strip -%}
              {%- assign tag_parts = tag | split: '·' -%}
              {%- assign benefit = tag_parts[0] | strip -%}
              {%- assign sub = '' -%}
              {%- if tag_parts.size > 1 -%}
                {%- assign sub = tag_parts[1] | strip -%}
              {%- endif -%}
              <blockquote
                class="hero-voice__quote"
                data-hero-voice-slide
                data-benefit="{{ benefit | escape }}"
                data-sub="{{ sub | escape }}"
              >{% assign words = trimmed | split: ' ' %}{% for word in words %}<span class="hero-voice__word">{{ word }}</span>{% endfor %}</blockquote>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if say_label != blank -%}
          <p class="hero-voice__say">{{ say_label }}</p>
        {%- endif -%}
      </div>

      <div class="hero-voice__actions">
        <a
          href="{{ listing_url | escape }}"
          class="btn btn--primary hero-voice__btn hero-voice__install"
          data-bizmis-install
          data-label-with-code="{{ 'bizmis.panel.install_with_code' | t | escape }}"
          data-label-no-code="{{ 'bizmis.panel.install' | t | escape }}"
          target="_blank"
          rel="noopener"
        >
          <svg class="hero-voice__btn-icon" viewBox="0 0 448 512" aria-hidden="true" focusable="false"><path fill="currentColor" d="M388.32,104.1a4.66,4.66,0,0,0-4.4-4c-2,0-37.23-.8-37.23-.8s-21.61-20.82-29.62-28.83V503.2L442.76,472S388.72,106.5,388.32,104.1ZM288.65,70.47a116.67,116.67,0,0,0-7.21-17.61C271,32.85,255.42,22,237,22a15,15,0,0,0-4,.4c-.4-.8-1.2-1.2-1.6-2C223.4,11.63,213,7.63,200.58,8c-24,.8-48,18-67.25,48.83-13.61,21.62-24,48.84-26.82,70.06-27.62,8.4-46.83,14.41-47.23,14.81-14,4.4-14.41,4.8-16,18-1.2,10-38,291.82-38,291.82L307.86,504V65.67a41.66,41.66,0,0,0-4.4.4S297.86,67.67,288.65,70.47ZM233.41,87.69c-16,4.8-33.63,10.4-50.84,15.61,4.8-18.82,14.41-37.63,25.62-50,4.4-4.4,10.41-9.61,17.21-12.81C232.21,54.86,233.81,74.48,233.41,87.69ZM200.58,24.44A27.49,27.49,0,0,1,215,28c-6.4,3.2-12.81,8.41-18.81,14.41-15.21,16.42-26.82,42-31.62,66.45-14.42,4.41-28.83,8.81-42,12.81C131.33,83.28,163.75,25.24,200.58,24.44ZM154.15,244.61c1.6,25.61,69.25,31.22,73.25,91.66,2.8,47.64-25.22,80.06-65.65,82.47-48.83,3.2-75.65-25.62-75.65-25.62l10.4-44s26.82,20.42,48.44,18.82c14-.8,19.22-12.41,18.81-20.42-2-33.62-57.24-31.62-60.84-86.86-3.2-46.44,27.22-93.27,94.47-97.68,26-1.6,39.23,4.81,39.23,4.81L221.4,225.39s-17.21-8-37.63-6.4C154.15,221,153.75,239.8,154.15,244.61ZM249.42,82.88c0-12-1.6-29.22-7.21-43.63,18.42,3.6,27.22,24,31.23,36.43Q262.63,78.68,249.42,82.88Z"/></svg>
          <span data-bizmis-install-label>{{ 'bizmis.panel.install' | t }}</span>
        </a>

        {%- if secondary_text != blank -%}
          <button type="button" class="btn btn--outline hero-voice__btn" data-open-voice-clerk>
            <svg class="hero-voice__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
            {{ secondary_text }}
          </button>
        {%- endif -%}
      </div>
    </div>

    {%- if cat_menu -%}
      <div class="hero-voice__aside">
        {%- if cards_title != blank -%}
          <p class="hero-voice__cards-title">{{ cards_title }}</p>
        {%- endif -%}
        <div class="hero-voice__cards">
          {%- for link in cat_menu.links limit: 4 -%}
            {%- assign col = link.object -%}
            <a href="{{ link.url }}" class="hero-voice__card">
              <span class="hero-voice__card-media">
                {%- if link.type == 'collection_link' and col.image != blank -%}
                  <img
                    src="{{ col.image | image_url: width: 480 }}"
                    alt="{{ link.title | escape }}"
                    width="480"
                    height="360"
                    loading="eager"
                  >
                {%- else -%}
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </span>
              <span class="hero-voice__card-title">{{ link.title }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bizmis demo store"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop like you'd ask someone who works here."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "This isn't a chatbot. Say what you're after out loud and the Bizmis Store Clerk finds it, compares it, even tracks your order — like the best in-store associate, online."
    },
    {
      "type": "text",
      "id": "say_label",
      "label": "Say-this prompt",
      "default": "Just say it out loud, the way you would to a clerk on the floor."
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary button (opens voice clerk)",
      "default": "Talk to the clerk"
    },
    {
      "type": "text",
      "id": "cards_title",
      "label": "Category cards title",
      "default": "What we stock"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
