{%- liquid
  assign eyebrow = section.settings.eyebrow
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign say_label = section.settings.say_label
  assign primary_text = section.settings.primary_cta_text
  assign secondary_text = section.settings.secondary_cta_text
  assign secondary_url = section.settings.secondary_cta_url | default: routes.all_products_collection_url
  assign cards_title = section.settings.cards_title

  assign prompts = 'bizmis.panel.examples' | t | newline_to_br | split: '<br />'
  assign tags = 'bizmis.panel.example_tags' | t | newline_to_br | split: '<br />'

  assign cat_menu_handles = 'catalog,main-menu' | split: ','
  assign cat_menu = nil
  for menu_handle in cat_menu_handles
    assign candidate = linklists[menu_handle]
    if candidate.links.size > 0
      assign cat_menu = candidate
      break
    endif
  endfor
-%}

<section class="hero-text hero-voice" {{ section.shopify_attributes }}>
  <div class="page-width hero-voice__inner">
    <div class="hero-voice__main">
      {%- if eyebrow != blank -%}
        <span class="hero-voice__eyebrow">
          <svg class="hero-voice__eyebrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
          {{ eyebrow }}
        </span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h1 class="hero-voice__heading">{{ heading }}</h1>
      {%- endif -%}

      {%- if subheading != blank -%}
        <p class="hero-voice__sub">{{ subheading }}</p>
      {%- endif -%}

      {%- comment -%}
        Rotating "say this" demo. The benefit / sub-benefit eyebrow and the
        shopper phrases are pulled from the shared Bizmis coachmark copy, so they
        stay consistent and localized. JS (HeroVoiceDemo) cycles the slides.
      {%- endcomment -%}
      <div class="hero-voice__demo" data-hero-voice>
        <div class="hero-voice__demo-eyebrow" aria-hidden="true">
          <span class="hero-voice__benefit" data-hero-voice-benefit></span>
          <span class="hero-voice__subbenefit" data-hero-voice-sub hidden></span>
        </div>

        <div class="hero-voice__slides" data-hero-voice-slides>
          {%- for prompt in prompts -%}
            {%- assign trimmed = prompt | strip -%}
            {%- if trimmed != blank -%}
              {%- assign tag = tags[forloop.index0] | strip -%}
              {%- assign tag_parts = tag | split: '·' -%}
              {%- assign benefit = tag_parts[0] | strip -%}
              {%- assign sub = '' -%}
              {%- if tag_parts.size > 1 -%}
                {%- assign sub = tag_parts[1] | strip -%}
              {%- endif -%}
              <blockquote
                class="hero-voice__quote"
                data-hero-voice-slide
                data-benefit="{{ benefit | escape }}"
                data-sub="{{ sub | escape }}"
              >{{ trimmed }}</blockquote>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if say_label != blank -%}
          <p class="hero-voice__say">{{ say_label }}</p>
        {%- endif -%}
      </div>

      <div class="hero-voice__actions">
        {%- if primary_text != blank -%}
          <button type="button" class="btn btn--primary hero-voice__btn" data-open-voice-clerk>
            <svg class="hero-voice__btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0"/><path d="M12 18v3"/></svg>
            {{ primary_text }}
          </button>
        {%- endif -%}
        {%- if secondary_text != blank -%}
          <a href="{{ secondary_url }}" class="btn btn--outline hero-voice__btn">{{ secondary_text }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if cat_menu -%}
      <div class="hero-voice__aside">
        {%- if cards_title != blank -%}
          <p class="hero-voice__cards-title">{{ cards_title }}</p>
        {%- endif -%}
        <div class="hero-voice__cards">
          {%- for link in cat_menu.links limit: 4 -%}
            {%- assign col = link.object -%}
            <a href="{{ link.url }}" class="hero-voice__card">
              <span class="hero-voice__card-media">
                {%- if link.type == 'collection_link' and col.image != blank -%}
                  <img
                    src="{{ col.image | image_url: width: 480 }}"
                    alt="{{ link.title | escape }}"
                    width="480"
                    height="360"
                    loading="eager"
                  >
                {%- else -%}
                  {{ 'collection-' | append: forloop.index | placeholder_svg_tag: 'placeholder' }}
                {%- endif -%}
              </span>
              <span class="hero-voice__card-title">{{ link.title }}</span>
            </a>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Powered by Bizmis · your voice store clerk"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop like you'd ask someone who works here."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "No filters, no search syntax. Say what you're after out loud — the clerk finds it, compares it, even tracks your order."
    },
    {
      "type": "text",
      "id": "say_label",
      "label": "Say-this prompt",
      "default": "Just say it out loud — tap the mic to start."
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary button (opens voice clerk)",
      "default": "Talk to the clerk"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary button text",
      "default": "Browse all products"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "cards_title",
      "label": "Category cards title",
      "default": "What we stock"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
