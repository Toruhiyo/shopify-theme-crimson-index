{%- liquid
  comment
    Plain merchant-style promo slideshow. The hero carries zero Bizmis chrome
    on purpose: the demo store has to look like a real storefront so the only
    Bizmis surfaces a lead sees are the orange promo bar and the widget,
    exactly as they would on their own store.
  endcomment

  assign height_class = ''
  if section.settings.height == 'large'
    assign height_class = 'hero--large'
  endif

  assign default_hero_images = 'hero-slide-headphones.png,hero-slide-laptop.png,hero-slide-smartphone.png,hero-slide-earbuds.png,hero-slide-smartwatch.png,hero-slide-speaker.png'

  assign has_block_images = false
  for block in section.blocks
    if block.settings.image != blank
      assign has_block_images = true
      break
    endif
  endfor

  if has_block_images
    assign slide_count = section.blocks.size
  else
    assign fallback_images = default_hero_images | split: ','
    assign slide_count = fallback_images.size
  endif

  assign interval = section.settings.autoplay_interval | times: 1000

  assign mock_chat = false
  assign unattended = false
  assign promo_video = false
  if request.query_string contains 'promo_video=mock'
    assign mock_chat = true
    assign promo_video = true
  elsif request.query_string contains 'promo_video=unattended'
    assign unattended = true
    assign promo_video = true
  elsif request.query_string contains 'promo_video=true' or request.query_string contains 'promo_video=opening' or request.query_string contains 'marketing=ad-1'
    assign promo_video = true
  endif

  comment
    The Bizmis demo film plays in the hero (snippets/bizmis-film.liquid), with its own smaller copy inviting the visitor
    to watch it, except in the recording links (the store's intro and the promo-video modes record the store itself),
    with ?storehero (the store's own hero, for recording demos) and with ?nofilm.
  endcomment
  assign show_film = false
  if section.settings.film_src != blank and promo_video == false
    unless request.query_string contains 'intro=' or request.query_string contains 'nofilm' or request.query_string contains 'storehero'
      assign show_film = true
    endunless
  endif

  assign hero_eyebrow = section.settings.subtitle
  assign hero_title = section.settings.title
  assign hero_cta = section.settings.cta_text
  assign hero_redefine = false
  assign hero_eyebrow_mark = false
  if mock_chat
    assign hero_eyebrow = 'YOUR STORE, WITH A TYPICAL CHATBOT.'
    assign hero_title = 'It always replies.'
    assign hero_cta = 'It never sells.'
  elsif unattended
    assign hero_eyebrow = 'YOUR STORE, UNATTENDED.'
    assign hero_title = 'Shoppers browse.'
    assign hero_cta = 'Nobody sells.'
  elsif show_film
    assign hero_eyebrow = section.settings.film_eyebrow
    assign hero_title = section.settings.film_title
    assign hero_cta = section.settings.film_title_cta
  endif
-%}

<section
  class="hero {{ height_class }}{% if show_film %} hero--film-copy{% endif %}"
  data-hero-slideshow
  data-autoplay-interval="{{ interval }}"
  data-bizmis-mark-url="{{ 'bizmis-logo-full-white-transparent.png' | asset_url }}"
  {{ section.shopify_attributes }}
>
  <div class="hero__slides">
    {%- if has_block_images -%}
      {%- for block in section.blocks -%}
        <div
          class="hero__slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <div class="hero__media">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 2000 }}"
                alt="{{ block.settings.image.alt | default: shop.name | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                {%- if forloop.first %} fetchpriority="high"{% endif %}
              >
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      {%- for img_file in fallback_images -%}
        <div
          class="hero__slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide="{{ forloop.index0 }}"
        >
          <div class="hero__media">
            <img
              src="{{ img_file | strip | asset_url }}"
              alt="{{ shop.name | escape }}"
              width="1280"
              height="720"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              {%- if forloop.first %} fetchpriority="high"{% endif %}
            >
          </div>
        </div>
      {%- endfor -%}
    {%- endif -%}
  </div>

  <div class="page-width hero__container">
    <div class="hero__content">
      {%- if hero_eyebrow_mark -%}
        {%- assign bizmis_mark_url = 'bizmis-logo-full-white-transparent.png' | asset_url -%}
        <p class="hero__subtitle hero__subtitle--mark" aria-label="AGENTIC SALES, WITH BIZMIS">
          <span class="hero__word">AGENTIC</span>
          <span class="hero__word">SALES,</span>
          <span class="hero__word">WITH</span>
          <span class="hero__word">
            <span
              class="hero__bizmis-mark"
              style="-webkit-mask-image: url('{{ bizmis_mark_url }}'); mask-image: url('{{ bizmis_mark_url }}');"
              aria-hidden="true"
            ></span>
          </span>
        </p>
      {%- elsif hero_eyebrow != blank -%}
        <p class="hero__subtitle">{{ hero_eyebrow }}</p>
      {%- endif -%}

      {%- if hero_title != blank -%}
        <h1 class="hero__title">
          {%- if hero_redefine -%}
            <span class="hero__title-line" data-hero-redefine aria-label="Your store sales agent.">
              <span class="hero__word">Your</span>
              {{- ' ' -}}
              <span class="hero__word">store</span>
              {{- ' ' -}}
              <span class="hero__word">
                <span class="hero__redefine-stem">sales</span><span class="hero__redefine" aria-hidden="true"><span class="hero__redefine-from">person</span><span class="hero__redefine-to">{{ ' agent' }}</span></span><span class="hero__redefine-dot">.</span>
              </span>
            </span>
          {%- else -%}
            <span class="hero__title-line">{{ hero_title }}</span>
          {%- endif -%}
          {%- if hero_cta != blank -%}
            {%- comment -%}
              The CTA is the title's second line: same scale, brand color,
              underlined, clickable. Starts a voice chat with the clerk; with
              the film on, it plays the film.
            {%- endcomment -%}
            {%- if show_film -%}
              <button type="button" class="hero__title-cta" data-film-open>
                {{- hero_cta -}}
              </button>
            {%- else -%}
              <button type="button" class="hero__title-cta" data-open-voice-clerk>
                {{- hero_cta -}}
              </button>
            {%- endif -%}
          {%- endif -%}
        </h1>
      {%- endif -%}

    </div>
  </div>

  {%- if show_film -%}
    {%- render 'bizmis-film-button', label: section.settings.film_label -%}
    {%- render 'bizmis-film',
      src: section.settings.film_src,
      label: section.settings.film_label,
      captions: section.settings.film_captions,
      cta_url: section.settings.film_cta_url,
      cta_label: section.settings.film_cta_label,
      end_cta: section.settings.film_end_cta,
      end_hold: section.settings.film_end_hold,
      agent_lines: section.settings.film_agent_lines
    -%}
  {%- endif -%}

  {%- if slide_count > 1 -%}
    <div class="hero__nav" aria-label="Slideshow navigation">
      <button class="hero__arrow hero__arrow--prev" data-hero-prev aria-label="Previous slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>

      <div class="hero__dots">
        {%- for i in (1..slide_count) -%}
          <button
            class="hero__dot{% if forloop.first %} is-active{% endif %}"
            data-hero-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>

      <button class="hero__arrow hero__arrow--next" data-hero-next aria-label="Next slide">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (85vh)" }
      ],
      "default": "large"
    },
    {
      "type": "range",
      "id": "autoplay_interval",
      "label": "Auto-rotate interval (seconds)",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Consumer electronics, curated"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The store clerk is in."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Voice clerk line (second title line)",
      "default": "Just say what you need.",
      "info": "Rendered as the highlighted second line of the heading. Opens a voice chat with the store clerk."
    },
    {
      "type": "header",
      "content": "Demo film"
    },
    {
      "type": "text",
      "id": "film_src",
      "label": "Film (HLS .m3u8 or MP4 URL)",
      "default": "https://cdn.bizmis.ai/media/film/demo-meridian/v21/master.m3u8",
      "info": "Plays over the hero from its play button. Leave empty to hide the film."
    },
    {
      "type": "text",
      "id": "film_label",
      "label": "Play button label",
      "default": "Watch the demo"
    },
    {
      "type": "text",
      "id": "film_eyebrow",
      "label": "Film copy: subtitle",
      "default": "Consumer electronics, curated",
      "info": "With the film on, the hero shows this copy (smaller) instead of the store's own. ?storehero shows the store's."
    },
    {
      "type": "text",
      "id": "film_title",
      "label": "Film copy: heading",
      "default": "Meet our store clerk."
    },
    {
      "type": "text",
      "id": "film_title_cta",
      "label": "Film copy: heading's second line (plays the film)",
      "default": "Watch it sell."
    },
    {
      "type": "text",
      "id": "film_agent_lines",
      "label": "The clerk's invite (lines separated by |)",
      "default": "Hi! I'm Meridian's Bizmis sales agent.|I match every shopper's needs, clear their doubts and win the sale.|Press play and watch me sell!",
      "info": "Said in the clerk's captions: the first with a wave, the last while it points at the film; then the last two take turns."
    },
    {
      "type": "text",
      "id": "film_captions",
      "label": "Captions (.vtt with Narrator and Shopper voices)",
      "default": "https://cdn.bizmis.ai/media/film/demo-meridian/v21/en-voices.vtt"
    },
    {
      "type": "text",
      "id": "film_cta_url",
      "label": "End button link",
      "default": "https://apps.shopify.com/bizmis"
    },
    {
      "type": "text",
      "id": "film_cta_label",
      "label": "End button label (for screen readers)",
      "default": "Install Bizmis on Shopify"
    },
    {
      "type": "text",
      "id": "film_end_cta",
      "label": "End title box (left,top,width,height as fractions of the frame)",
      "default": "0.2727,0.3162,0.4594,0.106"
    },
    {
      "type": "text",
      "id": "film_end_hold",
      "label": "Stop this many seconds before the end",
      "default": "1",
      "info": "For a film that fades out: it holds its last clean frame (the closing call to action)."
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background image"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Hero banner"
    }
  ]
}
{% endschema %}
