{%- liquid
  assign listing_url = settings.bizmis_app_listing_url | default: settings.bizmis_app_listing_url_fallback
  assign prompts = 'bizmis.panel.examples' | t | newline_to_br | split: '<br />'
  assign tags = 'bizmis.panel.example_tags' | t | newline_to_br | split: '<br />'
  assign categories = 'bizmis.panel.hero_categories' | t | split: ','
-%}

<section class="hero-clerk" data-hero-clerk {{ section.shopify_attributes }}>
  <div class="hero-clerk__bg" aria-hidden="true"></div>

  <div class="page-width hero-clerk__inner">
    <div class="hero-clerk__copy">
      <span class="hero-clerk__store">{{ 'bizmis.panel.hero_store' | t }}</span>
      <h1 class="hero-clerk__heading">{{ 'bizmis.panel.hero_heading' | t }}</h1>
      <p class="hero-clerk__subheading">{{ 'bizmis.panel.hero_subheading' | t }}</p>

      {%- if categories.size > 0 -%}
        <ul class="hero-clerk__chips" aria-label="{{ 'bizmis.panel.hero_store' | t | escape }}">
          {%- for category in categories -%}
            {%- assign label = category | strip -%}
            {%- if label != blank -%}
              <li class="hero-clerk__chip">{{ label }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="hero-clerk__actions">
        <button type="button" class="btn btn--primary hero-clerk__talk" data-hero-talk>
          <svg class="hero-clerk__mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3"/>
            <path d="M5 11a7 7 0 0 0 14 0"/>
            <path d="M12 18v3"/>
          </svg>
          <span>{{ 'bizmis.panel.talk' | t }}</span>
        </button>

        <a
          href="{{ listing_url | escape }}"
          class="btn btn--outline hero-clerk__install"
          data-bizmis-install
          data-label-with-code="{{ 'bizmis.panel.install_with_code' | t | escape }}"
          data-label-no-code="{{ 'bizmis.panel.install' | t | escape }}"
          target="_blank"
          rel="noopener"
        >
          <span data-bizmis-install-label>{{ 'bizmis.panel.install' | t }}</span>
        </a>
      </div>
    </div>

    <div class="hero-clerk__stage">
      <div class="hero-clerk__avatar">
        {%- if section.settings.clerk_image != blank -%}
          <img
            src="{{ section.settings.clerk_image | image_url: width: 720 }}"
            alt="{{ 'bizmis.panel.title' | t | escape }}"
            width="360"
            height="360"
            loading="eager"
          >
        {%- else -%}
          <img
            src="{{ 'bizmis-clerk.png' | asset_url }}"
            alt="{{ 'bizmis.panel.title' | t | escape }}"
            width="360"
            height="360"
            loading="eager"
          >
        {%- endif -%}
      </div>

      <div class="hero-clerk__prompts" data-hero-prompts>
        <p class="hero-clerk__say">
          <svg class="hero-clerk__say-mic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <rect x="9" y="2" width="6" height="12" rx="3"/>
            <path d="M5 11a7 7 0 0 0 14 0"/>
            <path d="M12 18v3"/>
          </svg>
          {{ 'bizmis.panel.hero_kicker' | t }}
        </p>

        <div class="hero-clerk__eyebrow" aria-hidden="true">
          <span class="hero-clerk__tag-benefit" data-hero-benefit></span>
          <span class="hero-clerk__tag-sub" data-hero-sub hidden></span>
        </div>

        <div class="hero-clerk__slides" data-hero-slides>
          {%- for prompt in prompts -%}
            {%- assign trimmed = prompt | strip -%}
            {%- if trimmed != blank -%}
              {%- assign tag = tags[forloop.index0] | strip -%}
              {%- assign tag_parts = tag | split: '·' -%}
              {%- assign benefit = tag_parts[0] | strip -%}
              {%- assign sub = '' -%}
              {%- if tag_parts.size > 1 -%}
                {%- assign sub = tag_parts[1] | strip -%}
              {%- endif -%}
              <figure
                class="hero-clerk__slide"
                data-hero-slide
                data-benefit="{{ benefit | escape }}"
                data-sub="{{ sub | escape }}"
              >
                <blockquote class="hero-clerk__quote">{{ trimmed }}</blockquote>
              </figure>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Headline, prompts and labels are translated in the locale files under bizmis.panel."
    },
    {
      "type": "image_picker",
      "id": "clerk_image",
      "label": "Clerk avatar",
      "info": "Transparent PNG of the Bizmis voice clerk. Defaults to the bundled render."
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
