{%- comment -%}
  Single switch for the top Bizmis demo banner and the header offset reserved for it.
  On by default. ?nobar hides it, and so do the recording links (?intro=, promo_video, marketing=), which record the
  store itself. Off: the bar and its space are both gone (no gap). Widget, demo panel, and install CTAs are independent.
{%- endcomment -%}
{%- liquid
  assign bizmis_top_banner_enabled = true
  if request.query_string contains 'nobar' or request.query_string contains 'intro=' or request.query_string contains 'promo_video' or request.query_string contains 'marketing='
    assign bizmis_top_banner_enabled = false
  endif
-%}
{%- if bizmis_top_banner_enabled and settings.bizmis_demo_enabled -%}
  {%- if mode == 'class' -%}has-promo-bar{%- endif -%}
{%- endif -%}
